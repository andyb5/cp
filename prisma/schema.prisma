generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String
  name              String
  subscriptionStatus String   @default("trial") // trial, active, expired
  subscriptionExpiry DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  counters          Counter[]
}

model Counter {
  id          String       @id @default(uuid())
  userId      String
  name        String
  color       String       @default("#007AFF")
  icon        String       @default("circle")
  goal        Int?
  increment   Int          @default(1)
  sortOrder   Int          @default(0)
  periodType  String       @default("daily") // daily, weekly, monthly, yearly, alltime
  periodStart String       @default("monday") // for weekly: day name; for monthly: "1"-"28"
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tallyEvents TallyEvent[]

  @@index([userId])
}

model TallyEvent {
  id        String   @id @default(uuid())
  counterId String
  value     Int      @default(1)
  timestamp DateTime @default(now())
  counter   Counter  @relation(fields: [counterId], references: [id], onDelete: Cascade)

  @@index([counterId])
  @@index([counterId, timestamp])
}
